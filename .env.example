# Application
APP_NAME=nexus-workbench
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-in-production-min-32-chars

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db

# Keycloak / OIDC
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-workbench
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/nexus/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://127.0.0.1:3000/callback
OIDC_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000

# Frontend
VITE_API_URL=http://127.0.0.1:8000
VITE_KEYCLOAK_URL=http://127.0.0.1:8080
VITE_KEYCLOAK_REALM=nexus
VITE_KEYCLOAK_CLIENT_ID=nexus-workbench

# LLM (optional, for AI-enhanced analysis)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Demo mode (binds to localhost only, refuses in production)
DEMO_MODE=true